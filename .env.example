# Receiver and collector runtime
METRICS_API_KEY=replace-with-a-long-random-value

# Additive normalized-series migration work performed per receiver startup.
# Set max batches to 0 to disable automatic backfill; reads retain the legacy path
# for each metric until all of its rows have a normalized series identity.
SERIES_BACKFILL_BATCH_SIZE=1000
SERIES_BACKFILL_MAX_BATCHES=10

# ERCOT Public Data API account and subscription keys
# Forecast publication collection remains off unless explicitly enabled. When
# enabled, all four ERCOT values and METRICS_API_KEY are required.
ERCOT_FORECAST_INGEST_ENABLED=false
ERCOT_FORECAST_ENDPOINT=http://receiver:8080/api/forecast-publications/ingest
ERCOT_RENEWABLE_INGEST_ENABLED=false
ERCOT_RENEWABLE_ENDPOINT=http://receiver:8080/api/renewable-publications/ingest
ERCOT_REGIONAL_RENEWABLE_INGEST_ENABLED=false
ERCOT_REGIONAL_RENEWABLE_ENDPOINT=http://receiver:8080/api/regional-renewable-publications/ingest
ERCOT_MARKET_MECHANICS_INGEST_ENABLED=false
ERCOT_MARKET_MECHANICS_ENDPOINT=http://receiver:8080/api/market-mechanics-publications/ingest
ERCOT_MARKET_GEOGRAPHY_INGEST_ENABLED=false
ERCOT_MARKET_GEOGRAPHY_ENDPOINT=http://receiver:8080/api/market-geography-publications/ingest
# NWS predictive-weather collection is credential-free but remains opt-in for
# reviewed deployment. NWS requires a stable identifying User-Agent.
NWS_WEATHER_INGEST_ENABLED=false
NWS_WEATHER_ENDPOINT=http://receiver:8080/api/predictive-weather/ingest
NWS_WEATHER_USER_AGENT=ercot-dashboard-observatory/1 (+https://github.com/venku122/ercot-dashboard)

# Opt-in monthly official ERCOT planning snapshots (collector polls every 6 hours).
ERCOT_LONG_HORIZON_INGEST_ENABLED=false
ERCOT_LONG_HORIZON_ENDPOINT=http://receiver:8080/api/texas-grid/ingest

# Credential-free EPA eGRID annual methodology context plus optional EIA-930
# hourly ERCO and Henry Hub daily context. A blank or DEMO_KEY credential makes
# zero EIA requests and leaves those two sections explicitly disabled.
EXTERNAL_CONTEXT_INGEST_ENABLED=false
EXTERNAL_CONTEXT_ENDPOINT=http://receiver:8080/api/external-context/ingest
EIA_API_KEY=
ERCOT_API_USERNAME=your-ercot-account-email
ERCOT_API_PASSWORD=your-ercot-account-password
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=your-public-api-subscription-key
ERCOT_ESR_API_SUBSCRIPTION_KEY=your-esr-api-subscription-key
