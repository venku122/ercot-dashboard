# Receiver and collector runtime
METRICS_API_KEY=replace-with-a-long-random-value

# Additive normalized-series migration work performed per receiver startup.
# Set max batches to 0 to disable automatic backfill; reads retain the legacy path
# for each metric until all of its rows have a normalized series identity.
SERIES_BACKFILL_BATCH_SIZE=1000
SERIES_BACKFILL_MAX_BATCHES=10

# ERCOT Public Data API account and subscription keys
ERCOT_API_USERNAME=your-ercot-account-email
ERCOT_API_PASSWORD=your-ercot-account-password
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=your-public-api-subscription-key
ERCOT_ESR_API_SUBSCRIPTION_KEY=your-esr-api-subscription-key
